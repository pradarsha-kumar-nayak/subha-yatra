<% layout("/layouts/boilerplate") %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1"style="margin-left: 5px;">
    <% for(let listing of allListing) {%>
      <a href="/listings/<%=listing.id%>">
       <div class="card col listing-card position position-relative">
         <i class="wishlist-heart position-absolute bi bi-heart top-0 end-0 m-2 fs-4" data-id="<%= listing._id %>"></i>
          <img src="<%=listing.image%>" class="card-img-top" alt="..." style="height: 18rem;">
          <div class="card-body">
             <p class="card-text">
               <b> <%= listing.title %></b><br>
                <%= listing.price.toLocaleString("en-IN",{style:"currency",currency:"INR"}) %>
             </p>
          </div>
       </div>
       </a>

    <%}%>

      </div>
