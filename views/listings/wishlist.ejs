<% layout("/layouts/boilerplate") %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1"style="margin-left: 5px;">
    <% for(let listing of wishlist) {%>
      <a href="/listings/<%=listing.id%>">
       <div class="card col listing-card">
       
          <img src="<%=listing.image%>" class="card-img-top" alt="..." style="height: 18rem;">
          <div class="card-body">
             <p class="card-text">
               <b> <%= listing.title %></b><br>
                <%= listing.price.toLocaleString("en-IN",{style:"currency",currency:"INR"}) %>
             </p>
          </div>
          <div class="card-footer">
           <form method="post" action="/listings/<%=listing.id%>/wishlist?_method=Delete">
               <button class="btn btn-danger w-100">remove</button>
            </form>
          </div>
       </div>
       </a>

    <%}%>

      </div>