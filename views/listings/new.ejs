<% layout("/layouts/boilerplate") %>
<body>
    
    <form method="post" action="/listings" class="needs-validation" novalidate>
     <div class="row">  
        
      <div class="col-6 offset-2 mt-5">
        <h2>Create new Listing</h2>
      <div class="mt-3">
         <label for="title" class="form-label">Add title</label>
         <input type="text" name="listing[title]" placeholder="enter title" class="form-control" required>
         <div class="invalid-feedback">please enter title</div>
          <div class="valid-feedback">title looks good</div>
      </div>
     
      <div class="mt-2">
         <label for="description" class="form-label">Add description</label>
         <textarea type="text" name="listing[description]" class="form-control" required></textarea>
         <div class="invalid-feedback">please enter description</div>
      </div>
      
       <div class="mt-2">
         <label for="image" class="form-label">Add image</label>
         <input type="text" name="listing[image]" placeholder="enter img url" class="form-control" >
         <div class="invalid-feedback">please enter img url</div>
       </div>

       <div class="mt-2">
        <label for="image" class="form-label">Add price</label>
        <input type="text" name="listing[price]" placeholder="enter price" class="form-control" required>
        <div class="invalid-feedback">please enter price</div>
       </div>
      
       
       <div class="mt-2">
        <label for="image" class="form-label">Add country</label>
        <input type="text" name="listing[country]" placeholder="enter country" class="form-control"required>
        <div class="invalid-feedback">please enter country</div>
       </div>
      
       <div class="mt-2">
        <label for="image" class="form-label">Add location</label>
         <input type="text" name="listing[location]" placeholder="enter location" class="form-control"required>
         <div class="invalid-feedback">please enter location</div>
       </div>
      
       
       <button class="btn btn-dark mt-3 mb-2 newaddbtn ">submit</button>

    </form>
</div>
</div>  
    
</body>
</html>